# Variable names/placeholders only. Never commit real secrets or paste private
# keys/provider client secrets into chat. Supply secrets via trusted server env.

# Firebase Authentication (Google provider) + Cloud Firestore project.
# Firebase Console -> Project settings -> Your apps -> Web app config.
# These four values are public Firebase identifiers, NOT Admin credentials.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# FIREBASE_AUTH_DOMAIN must be <project-id>.firebaseapp.com.
# Enable Google in Authentication and authorize the actual website domain.
# Google login is separate from the Blogger publishing OAuth authorization.

# Website only: restricted Firebase Admin service identity. On Firebase Cloud
# Functions, use the runtime service account/ADC instead; NEVER ship its key to
# the browser or put it in NEXT_PUBLIC_*. Use a dedicated least-privilege account.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# The private key accepts escaped \n line breaks. Store it securely, not here.
# On Functions, FIREBASE_PROJECT_ID may default to injected GCLOUD_PROJECT.

# Website-only app session signing secret, at least 32 random characters.
# Firebase Admin verifies the ID token first; the signed UID/name app cookie is
# HttpOnly, Secure on HTTPS, seven days, with managed-user revocation checks.
AUTH_SESSION_SECRET=

# Exact public HTTPS origin, no path/query. Registered provider callbacks and
# generated image links use this origin. Images must be reachable without login.
APP_URL=https://pincraftly.vercel.app

# Exactly 32 random bytes in standard base64, retained/backed up across deploys.
# The SAME value is required by website and Functions: per-UID/purpose AES-GCM
# credentials plus HMAC image signatures. Bind this as a Functions secret.
AUTOMATION_ENCRYPTION_KEY=

# Set to 1 ONLY after an authorized deployment of the native scheduled Function,
# its Scheduler job and IAM have been verified. This is an operator declaration,
# not proof of execution: Dashboard separately requires a fresh real heartbeat.
FIREBASE_SCHEDULER_CONFIGURED=

# Pinterest OAuth application, NOT a user password or manually pasted token.
# Exact callback: https://pincraftly.vercel.app/api/integrations/pinterest/callback
# Scopes: pins:read,pins:write,boards:read,boards:write,user_accounts:read
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Separate Google OAuth Web app with Blogger API + offline consent configured.
# Exact callback: https://pincraftly.vercel.app/api/integrations/blogger/callback
# Scope: https://www.googleapis.com/auth/blogger; offline + consent + PKCE S256.
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=

# OPTIONAL: enable the protected maintenance HTTP/CLI worker, not the native
# Cloud Scheduler trigger. Use a separate random 32-256-character Bearer secret.
# Omit in production unless an operator needs this maintenance endpoint.
CRON_SECRET=

# Preview/local publishing is blocked by default. This override is only for a
# deliberately isolated test instance with synthetic credentials, never prod data.
# AUTOMATION_ALLOW_NON_PRODUCTION=1

# No DATABASE_URL, SQL migration, Firebase Storage upload, Gmail/password forms,
# global user posting tokens or browser-stored credentials are required.
# Emulator activation is deliberately NOT included in production examples.
# See docs/full-auto-mode.md for guarded local emulator instructions and costs.
