# Names/placeholders only. Never commit real secrets or paste them into chat.
# Authentication: Google Identity Services Web Client; authorize APP_URL as a
# JavaScript origin. This is separate from the Blogger publishing OAuth grant.
GOOGLE_CLIENT_ID=
AUTH_SESSION_SECRET=

# Canonical public HTTPS origin, no path/query. Sign in/connect on this exact
# host. Public Pin images must not be behind deployment protection or login.
APP_URL=https://pincraftly.vercel.app

# Persistent PostgreSQL, pooled URL preferred. TLS certificates are verified.
# Operator applies BOTH migrations with npm run db:migrate.
DATABASE_URL=
# DATABASE_SSL=disable  # isolated loopback test database ONLY

# Exactly 32 random bytes encoded as standard base64. AES-256-GCM per user AND
# provider/purpose, and HMAC image URLs. Retain a secure backup across deploys.
AUTOMATION_ENCRYPTION_KEY=

# Separate random 32–256-character worker secret, not an OAuth/user token.
# Vercel Schedules captures it at deployment: redeploy after changing it.
CRON_SECRET=

# Pinterest OAuth application (not a user's Pinterest login/password/token).
# Registered redirect: https://pincraftly.vercel.app/api/integrations/pinterest/callback
# Scopes: pins:read,pins:write,boards:read,boards:write,user_accounts:read
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Google Web OAuth application with Blogger API enabled and consent configured.
# Registered redirect: https://pincraftly.vercel.app/api/integrations/blogger/callback
# Scope: https://www.googleapis.com/auth/blogger
# Connect requests access_type=offline, prompt=consent and PKCE S256.
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=

# Background execution is blocked outside production by default. Use this only
# on an explicitly authorized isolated/alternative-host instance, never tests
# pointed at production data or credentials:
# AUTOMATION_ALLOW_NON_PRODUCTION=1

# NO account passwords, Gmail/password forms, global posting access tokens,
# NEXT_PUBLIC secrets, browser-local credentials or fixture activation settings.
# Each user authorizes Pinterest/Google on their own consent page. Pinterest
# access+refresh+expiry are encrypted at rest; Blogger stores refresh token ONLY.
# The optional AI API key is entered after sign-in and encrypted separately.
