# Google Identity Services: public OAuth Web Client ID (not a client secret).
# Add https://pincraftly.vercel.app as an authorized JavaScript origin in Google.
GOOGLE_CLIENT_ID=

# Server-only session signing key. Set to at least 32 cryptographically random
# characters in the deployment environment. Never commit the real value.
AUTH_SESSION_SECRET=

# Canonical origin used in same-origin/CSRF validation.
APP_URL=https://pincraftly.vercel.app

# Missing configuration intentionally leaves Google Login unavailable;
# no demo identity, client-side profile spoof, or auth bypass is enabled.
