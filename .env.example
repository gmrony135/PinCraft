# Placeholders/public identifiers only. NEVER commit real values, a private key,
# a user refresh grant or a session file. Do not use NEXT_PUBLIC_* for secrets.
# Setup: docs/blogger-manual-pinterest-setup.bn.md
# Recurring generation + optional Pin: docs/blogger-trend-automation.bn.md

# Selected path: reviewed Blogger automatic -> Pinterest manual/native scheduler.
# This is also the default when unset. Do NOT set legacy_api for this rollout.
PINCRAFT_PUBLISHING_MODE=blogger_manual_pin
APP_URL=https://pincraftly.vercel.app

# Existing Firebase Auth + Firestore Spark project. These four are public Web
# identifiers, not Admin credentials. Keep the existing application values.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Auth domain: <project-id>.firebaseapp.com. Enable Google + Email/Password;
# authorize the real website domain. Password users must verify their email.

# Server-only Admin identity for the existing project. Private key accepts real
# line breaks or escaped \n. Never ship to the browser. No new IAM/Rules/billing
# change is implied by this example.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Existing website app-session signing secret, at least 32 random characters.
AUTH_SESSION_SECRET=

# REUSE the existing exact 32-byte standard-base64 encryption key. Website and
# Actions MUST share it; changing it breaks existing encrypted records.
AUTOMATION_ENCRYPTION_KEY=
# Optional alias: TOKEN_ENCRYPTION_KEY. If both exist they MUST be identical.
# Retain AUTOMATION_ENCRYPTION_KEY for older signed-image compatibility.

# Google OAuth Web client with Blogger API v3 enabled. Separate Blogger consent
# from Firebase Google sign-in. Scope: https://www.googleapis.com/auth/blogger
# Offline + prompt=consent + state/browser/PKCE handled by the application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pincraftly.vercel.app/api/blogger/callback
# Existing BLOGGER_CLIENT_ID / BLOGGER_CLIENT_SECRET are supported as a pair
# ONLY when GOOGLE_CLIENT_ID is absent. Do not mix different clients.

# GITHUB ACTIONS configuration (Settings -> Secrets and variables -> Actions):
# Variables: PINCRAFT_FIREBASE_PROJECT_ID, GOOGLE_CLIENT_ID,
#            REVIEWED_BLOGGER_SCHEDULER_ENABLED (leave unset/false until ready).
# Secrets: PINCRAFT_FIREBASE_ADMIN_CLIENT_EMAIL,
#          PINCRAFT_FIREBASE_ADMIN_PRIVATE_KEY,
#          PINCRAFT_TOKEN_ENCRYPTION_KEY, GOOGLE_CLIENT_SECRET.
# The workflow maps the PINCRAFT_* names to the server names above.
# No global GOOGLE_REFRESH_TOKEN: per-owner offline grants remain encrypted in
# Firestore. No Pinterest API/cookies/session or publishing AI key is required.

# Existing live AI generation, also reused by explicitly consented recurring
# articles through the OIDC-only internal endpoint. Never copy these keys into
# the publishing
# workflow. No paid upgrade is enabled by setting them; provider quotas apply.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Existing image generation remains downloadable WebP. Optional browser-only
# PNG/ZIP conversion in the manual publishing UI is not a hosting/upload service.
AI_USER_DAILY_TEXT_LIMIT=30
AI_USER_DAILY_IMAGE_LIMIT=5
AI_GLOBAL_DAILY_TEXT_LIMIT=150
AI_GLOBAL_DAILY_IMAGE_LIMIT=20

# Existing manual billing controls; collection remains closed until a verified
# allowlisted reviewer deliberately enables the plan. No approver is inferred.
BILLING_ADMIN_UIDS=
BILLING_ADMIN_EMAILS=
# Confirmed fallback plan: BDT 99 / 30 days; total 2+2 including free 1+1.
# Manual Pinterest activity is not monitored or quota-verified by this mode.

# HISTORICAL / DEFERRED ONLY. Not required by this selected deployment. Existing
# saved records are retained; their API publishing entrypoints default to blocked.
# PINCRAFT_PUBLISHING_MODE=legacy_api  # isolated legacy tests only, not rollout
# BLOGGER_CLIENT_ID=
# BLOGGER_CLIENT_SECRET=
# PINTEREST_CLIENT_ID=
# PINTEREST_CLIENT_SECRET=
# PINTEREST_ACCESS_TIER=
# CRON_SECRET=
# LEGACY_PINTEREST_API_SCHEDULER_ENABLED=  # leave unset/false
# FIREBASE_SCHEDULER_CONFIGURED=
# AUTOMATION_SCHEDULER=
# AUTOMATION_GITHUB_REPOSITORY=gmrony135/PinCraft
# AUTOMATION_GITHUB_REPOSITORY_ID=1456649831
# No native Functions/Scheduler deployment, VPS, Worker or Blaze is required.
# Emulator activation is intentionally absent from production examples.

# Vercel normal system env exposure must stay enabled for recurring workload
# verification (VERCEL_GIT_COMMIT_SHA is supplied by Vercel, not a secret to copy).
# The reviewed Actions workflow uses id-token:write, not a long-lived worker key.
