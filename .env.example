# Public OAuth Web Client ID. Add the production origin to Google OAuth's
# authorized JavaScript origins. Missing auth never creates a fake account.
GOOGLE_CLIENT_ID=

# Server-only session signing key: at least 32 random characters.
AUTH_SESSION_SECRET=

# Canonical, publicly reachable HTTPS origin. No path or trailing query.
# Pinterest must be able to fetch /api/automation/image/* without login or
# deployment protection. Generated images contain public post titles, no keys.
APP_URL=https://pincraftly.vercel.app

# Permanent PostgreSQL (use a provider's pooled connection URL). Apply the SQL
# migration with npm run db:migrate after securely setting DATABASE_URL.
# TLS certificates are verified, including when the URL has sslmode parameters.
DATABASE_URL=
# Only for an isolated local PostgreSQL test instance, never a cloud database:
# DATABASE_SSL=disable

# Exactly 32 random bytes, encoded as standard base64. Used for per-user
# AES-256-GCM and signed public Pin image URLs. Keep a secure backup; changing
# this key makes old connections unreadable and invalidates old image URLs.
AUTOMATION_ENCRYPTION_KEY=

# Random secret >=32 characters. Vercel Schedules sends Authorization: Bearer.
# Redeploy after changing it. Do not use a user's token or session signing key.
CRON_SECRET=

# Blogger only: same OAuth application that issued the user's offline refresh
# token; scope https://www.googleapis.com/auth/blogger, owner/admin blog access.
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=

# Optional Pinterest automatic token refresh. If missing, access-token expiry
# pauses automation honestly; reauthorization is required, not faked.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Preview/local execution is blocked by default. For an isolated, explicitly
# authorized development instance only (never point tests at a production DB):
# AUTOMATION_ALLOW_NON_PRODUCTION=1

# Provider API keys/tokens are entered in the authenticated Dashboard, sent via
# same-origin HTTPS, and stored encrypted in PostgreSQL. No NEXT_PUBLIC secret,
# client localStorage credential, .env commit, or fake Connected/Success state.
