# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js
.next/
out/
build/
dist/

# Env (never commit secrets)
.env
.env.*
!.env.example

# Credentials
.git-credentials
.gitconfig
.netrc

# Cache / tooling
.cache/
.vercel/
coverage/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Test artifacts
.shots/
test-results/

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# local tooling dirs
.npm/
.config/
.nvm/
.sudo_as_admin_successful

